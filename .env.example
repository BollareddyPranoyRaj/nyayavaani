# ==========================================
# NyayaVaani - Environment Configuration
# ==========================================

# Gnani AI API Key (Obtain from https://app.gnani.ai - 3 free keys available)
# If left empty, NyayaVaani automatically activates its High-Fidelity Simulator Engine for offline/demo testing!
GNANI_API_KEY=

# Gnani Base API URL (Vachana Platform)
GNANI_BASE_URL=https://api.vachana.ai

# Speech-to-Text Model (Prisma)
PRISMA_MODEL=prisma-v3.0

# Text-to-Speech Model (Timbre)
TIMBRE_MODEL=timbre-v3.0

# Server Port
PORT=8000
HOST=0.0.0.0
